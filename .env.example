# ===== Shared =====
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ===== MongoDB (Atlas) =====
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DATABASE=fazercards_webhook

# ===== Ozon =====
OZON_CLIENT_ID=your-ozon-client-id
OZON_API_KEY=your-ozon-api-key
OZON_WEBHOOK_SECRET=ozon-secret-here
ENFORCE_OZON_AUTH=false

# ===== FazerCards (fzr.cards) =====
FZ_API_KEY=your-fazercards-api-key
FZ_WEBHOOK_SECRET=fazercards-secret-here
ENFORCE_FZR_AUTH=false
